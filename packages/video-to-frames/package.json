{
  "name": "@workbench-tools/video-to-frames",
  "version": "0.1.0",
  "description": "Turn a video into a preloaded sequence of frame images, entirely in the browser \u2014 with one-call ZIP export and download.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video",
    "frames",
    "canvas",
    "zip",
    "browser",
    "extraction",
    "thumbnail",
    "sprite"
  ],
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "peerDependenciesMeta": {},
  "publishConfig": {
    "access": "public"
  }
}
